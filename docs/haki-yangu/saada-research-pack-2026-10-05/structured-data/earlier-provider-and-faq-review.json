  "faqDrafts": [
    {
      "id": "dismissal",
      "questionSw": "Nimeachishwa kazi. Nianzie wapi?",
      "answerSw": "CMA inaeleza matumizi ya fomu CMA F.1 na muda wa siku 30 kwa mgogoro wa kuachishwa kazi. Muda ukipita, inaeleza maombi ya kusikilizwa nje ya muda. Wasiliana na CMA au mtoa msaada wa kisheria haraka ili kuthibitisha muda unaohusu hali yako.",
      "sources": [
        "cma-faq"
      ],
      "jurisdiction": "Mainland; confirm applicability",
      "status": "draft_legal_review_required"
    },
    {
      "id": "other-labour",
      "questionSw": "Nina mgogoro mwingine wa kazi; kuna muda wa kuwasilisha?",
      "answerSw": "FAQ ya CMA inaeleza siku 60 kwa migogoro mingine ya kazi na utaratibu wa kuomba kusikilizwa nje ya muda. Aina ya mgogoro na tarehe husika zinahitaji kuthibitishwa kabla ya kuhesabu siku ya mwisho.",
      "sources": [
        "cma-faq"
      ],
      "jurisdiction": "Mainland; confirm applicability",
      "status": "draft_legal_review_required"
    },
    {
      "id": "cma-service",
      "questionSw": "Kujaza fomu ya CMA kunatosha?",
      "answerSw": "CMA inaeleza kwamba nakala inapaswa kukabidhiwa upande mwingine na uthibitisho wa kukabidhi kuambatanishwa. Hakiki njia inayokubalika sasa na CMA.",
      "sources": [
        "cma-faq"
      ],
      "status": "draft_legal_review_required"
    },
    {
      "id": "legal-aid-territory",
      "questionSw": "Sheria ya Msaada wa Kisheria inatumika Tanzania nzima?",
      "answerSw": "Kifungu cha 2 cha Sheria ya Msaada wa Kisheria, Sura ya 21, Toleo la 2023, kinaeleza Tanzania Bara. Kwa Zanzibar, Saada lazima itafute sheria na utaratibu unaotumika huko.",
      "sources": [
        "legal-aid"
      ],
      "locator": "section 2, PDF page 4",
      "status": "draft_legal_review_required"
    },
    {
      "id": "rita-online",
      "questionSw": "Naweza kuomba cheti cha kuzaliwa mtandaoni?",
      "answerSw": "RITA inaorodhesha maombi ya cheti cha kuzaliwa kupitia huduma za eRITA. Fuata kiungo rasmi na hakiki nyaraka na ada zinazohitajika kwa ombi lako.",
      "sources": [
        "rita"
      ],
      "status": "draft_editorial_review_required"
    },
    {
      "id": "shelter",
      "questionSw": "Ninaweza kupata sehemu salama ya kukaa?",
      "answerSw": "Tunaweza kukusaidia kuwasiliana na shirika la ulinzi kupitia mawasiliano yake ya umma. Nafasi na utaratibu wa kupokelewa lazima vithibitishwe kabla ya safari. Usitumie anwani iliyopatikana mtandaoni kama uthibitisho wa kupokelewa.",
      "sources": [
        "wotesawa",
        "kiwohede"
      ],
      "status": "original_draft_safeguarding_review_required"
    }
