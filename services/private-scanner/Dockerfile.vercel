FROM clamav/clamav:stable@sha256:ebec5bc138401b36ae987caa1a3fa3c3b2a21ed3d51f0bfa5852825e663e67b0
RUN apk add --no-cache nodejs=24.22.1-r0
WORKDIR /app
COPY --chown=clamav:clamav server.mjs vercel-start.mjs clamd.vercel.conf freshclam.vercel.conf ./
USER clamav
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["node", "/app/vercel-start.mjs"]
