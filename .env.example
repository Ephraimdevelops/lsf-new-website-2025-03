# Public browser configuration
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Set these with `npx convex env set`; never expose them to Vite.
# CLERK_JWT_ISSUER_DOMAIN=
# OPENAI_API_KEY=
# RESEND_API_KEY=
# N8N_CHATBOT_WEBHOOK_URL=
# PRIVATE_SCANNER_URL=https://your-private-scanner.example/scan
# PRIVATE_SCANNER_TOKEN=use-a-secret-manager-and-at-least-32-random-characters
# PRIVATE_SCANNER_TRANSPORT=fetch
# Configure only on the isolated Vercel scanner, not the website or mobile app:
# SCAN_SOURCE_URL=https://your-development-deployment.convex.site/secure-scan-source

# Public Mapbox token for maps; never place secret tokens here.
VITE_MAPBOX_ACCESS_TOKEN=

# Optional development/production Convex server setting, NOT a VITE/browser variable.
# Empty means cost monitoring only. Set a positive USD amount only after owner selection.
# Enforcing mode blocks unpriced models and audio without a verified duration bound.
SAADA_MONTHLY_BUDGET_USD=
