# Public browser configuration
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Set these with `npx convex env set`; never expose them to Vite.
# CLERK_JWT_ISSUER_DOMAIN=
# OPENAI_API_KEY=
# RESEND_API_KEY=
# N8N_CHATBOT_WEBHOOK_URL=
# PRIVATE_SCANNER_URL=https://your-private-scanner.example/scan
# PRIVATE_SCANNER_TOKEN=use-a-secret-manager-and-at-least-32-random-characters
# PRIVATE_SCANNER_TRANSPORT=fetch
# Configure only on the isolated Vercel scanner, not the website or mobile app:
# SCAN_SOURCE_URL=https://your-development-deployment.convex.site/secure-scan-source

# Public Mapbox token for maps; never place secret tokens here.
VITE_MAPBOX_ACCESS_TOKEN=

# Optional development/production Convex server setting, NOT a VITE/browser variable.
# Empty means cost monitoring only. Set a positive USD amount only after owner selection.
# Enforcing mode blocks unpriced models and audio without a verified duration bound.
SAADA_MONTHLY_BUDGET_USD=

# Meta messaging — server-only Convex environment variables, never VITE_/EXPO_PUBLIC_.
# Keep disabled until channel permissions, privacy notice, credentials and subscriptions are approved.
# META_MESSAGING_ENABLED=false
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_GRAPH_VERSION= (choose the supported version shown in the Meta app)
# META_PAGE_ID=
# META_PAGE_TOKEN=
# META_INSTAGRAM_ID=
# META_INSTAGRAM_TOKEN=
# Instagram Unified Login uses graph.facebook.com; legacy Instagram Login uses graph.instagram.com.
# META_INSTAGRAM_AUTH_MODE=unified
# Unified Login credentials are stored only in the server-only Convex connection table.
# OAuth return URL derives from the deployment's built-in CONVEX_SITE_URL;
# register that deployment's /meta-instagram-return URI in Meta before connecting.
# The environment-token fields above are legacy fallback configuration.
# For an operator-authorised connection, configure a SHA-256 state hash and
# an absolute expiry in milliseconds (15 minutes); state is consumed once.
# META_INSTAGRAM_CONNECT_STATE_HASH=
# META_INSTAGRAM_CONNECT_EXPIRES_AT=
# META_WHATSAPP_PHONE_ID=
# META_WHATSAPP_TOKEN=
