{
  "expo": {
    "name": "Haki Yangu",
    "slug": "haki-yangu",
    "version": "1.0.0",
    "scheme": "hakiyangu",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.lsftz.hakiyangu"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.lsftz.hakiyangu",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Haki Yangu to record an answer you choose to transcribe.",
          "enableBackgroundRecording": false,
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Haki Yangu to select documents and profile photos.",
          "cameraPermission": "Allow Haki Yangu to photograph a document when you choose.",
          "microphonePermission": "Allow Haki Yangu to record an answer you choose to transcribe.",
          "colors": {
            "cropToolbarColor": "#8A1538",
            "cropToolbarIconColor": "#FFFFFF",
            "cropToolbarActionTextColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8A1538",
          "defaultChannel": "case-updates",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to find nearby public legal help when you choose.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "@rnmapbox/maps"
    ],
    "extra": {
      "eas": {
        "projectId": "bc4f59f4-7366-439c-b24b-2c418807122b"
      }
    },
    "owner": "ephraimngowi"
  }
}
